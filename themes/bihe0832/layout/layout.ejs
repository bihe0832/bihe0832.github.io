<!doctype html>
<html>
<head>
  <%- partial('partial/header') %>
</head>
<body>
  <div class="container">
    <div class="row">
      <%- partial('partial/navside') %>
      <div class="col-md-8 col-lg-8 col-sm-12 col-xs-12 aside3">
        <div id="container">
          <div id="pjax">
            <%- body %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%- partial('partial/footer') %>
  <script type="text/javascript" charset="UTF-8">
    (function () {
      var STATS_URL = 'https://stats.bihe0832.com/stats';
      var KEY = 'bihe0832_blog_vid';
      var vid = localStorage.getItem(KEY);
      if (!vid) {
        vid = (window.crypto && crypto.randomUUID && crypto.randomUUID()) ||
          ('vid-' + Date.now() + '-' + Math.random().toString(36).slice(2));
        localStorage.setItem(KEY, vid);
      }
      fetch(STATS_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ page: location.href, vid: vid, ref: document.referrer })
      }).catch(function () {});
    })();
  </script>
</body>
</html>
